#&'debug'
#&'strict'
#&'log'

# TODO: build us_build_main () from inc

_us_build_init ()
{
  # XXX: build us-pp too...
  . us-pp &&
  _us_pp_init &&
  _us_pp_load ||
    failerr "E$? Loading script env" || exit
}

#:include user-script.main.bash.build
#&'main' _us_build_init && "${script_name//[^A-Za-z0-9_]/_}_main" "$@"
#:modeline
