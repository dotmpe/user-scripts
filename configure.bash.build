#:generator
#&'strict'
#&'verbosity'
#&'debug'
#&'us-config'
#&'us-host'
#&'log'
# ! ((DEBUG)) || set -x
#&'us-basedir'
# FIXME: &'us-package'

>&2 mkdir -vp tool/redo/recipe tool/us/part

assert_symlink \\
  "tool/redo/recipe/&build-alias.us-build.do" \\
  "$U_S"/tool/us/part/user-script.build-alias.us-build.do

assert_symlink @config.do.do "tool/redo/recipe/&build-alias.us-build.do"
assert_symlink @env.do.do "tool/redo/recipe/&build-alias.us-build.do"
assert_symlink @build.do.do "tool/redo/recipe/&build-alias.us-build.do"
assert_symlink @test.do.do "tool/redo/recipe/&build-alias.us-build.do"

#us-build ./env.bash.build &&
#. ./env.bash
#
#redo @{env,test,config}.do

#:modeline
# pp:pwd:gpp-mode=shell_nc:
